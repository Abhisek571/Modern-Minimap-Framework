#include <windows.h>

#include "PhotoBakerVersion.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MMPB_VERSION_MAJOR, MMPB_VERSION_MINOR, MMPB_VERSION_PATCH, 0
PRODUCTVERSION MMPB_VERSION_MAJOR, MMPB_VERSION_MINOR, MMPB_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "itsPigeon2000"
			VALUE "FileDescription", "Modern Minimap Photo Baker"
			VALUE "FileVersion", MMPB_VERSION_STRING
			VALUE "InternalName", "ModernMinimapPhotoBaker"
			VALUE "LegalCopyright", "itsPigeon2000"
			VALUE "OriginalFilename", "ModernMinimapPhotoBaker.exe"
			VALUE "ProductName", "Modern Minimap Photo Baker"
			VALUE "ProductVersion", MMPB_VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
